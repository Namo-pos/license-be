# POS-License Configuration
PORT=4000
BASE_DOMAIN=nomapos.com

# Cloudflare Settings
# Set CF_SANDBOX=true to test without real Cloudflare API credentials
CF_SANDBOX=true

# Real Cloudflare Credentials (Used when CF_SANDBOX=false)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# Local Service Target on Client POS Desktop
LOCAL_TARGET_SERVICE=http://localhost:5000

# Cloudflare D1 Database ID
CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_d1_database_id_here

# Local SQLite dev database (used as fallback when offline)
DATABASE_URL="file:./prisma/dev.db"
